# PostgreSQL connection string (async driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_learning_assistant

# OpenAI API key used for both chat completions and embeddings.
OPENAI_API_KEY=sk-...

# Chat model used for content generation (summary/quiz).
OPENAI_MODEL=gpt-4o-mini

# Embedding model used to embed document chunks at ingestion time.
EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated list of origins allowed to call the API via CORS (frontend dev server).
CORS_ORIGINS=http://localhost:5173
